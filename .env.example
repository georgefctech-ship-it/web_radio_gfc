# Icecast Configuration (Caster.fm)
# ICECAST_SERVER: e.g., shoutcast.caster.fm
ICECAST_SERVER=
# ICECAST_PORT: e.g., 8000
ICECAST_PORT=8000
# ICECAST_MOUNT: e.g., /live
ICECAST_MOUNT=/live
# ICECAST_PASSWORD: your source password
ICECAST_PASSWORD=
# ICECAST_GENRE: e.g., Radio
ICECAST_GENRE=Radio
# ICECAST_NAME: e.g., My Live Radio
ICECAST_NAME=My Live Radio
# ICECAST_URL: e.g., https://caster.fm
ICECAST_URL=https://caster.fm
# ICECAST_DESCRIPTION: e.g., Live Broadcast from Web Browser
ICECAST_DESCRIPTION=Live Broadcast from Web Browser
