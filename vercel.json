{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/radio/(.*)",
      "destination": "/api/radio"
    },
    {
      "source": "/api/supabase/(.*)",
      "destination": "/api/supabase"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
